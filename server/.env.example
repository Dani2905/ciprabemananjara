# Local development only. Never put real credentials in this example file.
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0
PUBLIC_ORIGINS=http://localhost:3000

# Database values are intentionally blank until the host has been verified
# and an administrator approves creating the production database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

SESSION_TTL_HOURS=8

# Contact form delivery by email. Copy the real SMTP values into .env only;
# never put live credentials in this example file or in the archive.
CONTACT_TO_EMAIL=contact@rabemananjara.mg
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
